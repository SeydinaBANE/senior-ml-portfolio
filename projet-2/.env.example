# App
APP_ENV=development
SECRET_KEY=change-me-in-production
API_V1_PREFIX=/api/v1

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/secure_platform
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/secure_platform

# Redis
REDIS_URL=redis://localhost:6379/0

# OPA (Open Policy Agent)
OPA_URL=http://localhost:8181

# JWT
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Prometheus
METRICS_PORT=9090
