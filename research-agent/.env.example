# App
APP_ENV=development
API_V1_PREFIX=/api/v1

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Tavily (web search)
TAVILY_API_KEY=tvly-...

# Google (Gmail + Calendar) — OAuth2
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_TOKEN_PATH=.secrets/google_token.json

# Notion
NOTION_API_KEY=secret_...

# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_DEFAULT_CHANNEL=#research-reports

# Research agent
MAX_SEARCH_QUERIES=5
MAX_SOURCES_PER_QUERY=3
MIN_SOURCE_CONFIDENCE=0.6
