# App
APP_ENV=development
SECRET_KEY=change-me-in-production
API_V1_PREFIX=/api/v1

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_platform
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/agent_platform

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Pricing (USD per 1k tokens)
PRICE_PER_1K_INPUT_TOKENS=0.005
PRICE_PER_1K_OUTPUT_TOKENS=0.015

# Observability
OTLP_ENDPOINT=http://otel-collector:4317
METRICS_PORT=9090
