# App
APP_ENV=development
API_V1_PREFIX=/api/v1

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# PostgreSQL + pgvector
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/enterprise_rag
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/enterprise_rag

# Notion
NOTION_API_KEY=secret_...
NOTION_DATABASE_ID=...

# Self-RAG
MAX_RETRIEVAL_ITERATIONS=3
TOP_K_CHUNKS=6
BM25_WEIGHT=0.4
VECTOR_WEIGHT=0.6
